import { useCallback, useEffect, useState, type FormEvent } from "react";
import { ApprovalHub } from "./ApprovalHub";
import type { Project } from "../lib/api";

type Template={templateKey:string;name:string;mission:string;suggestedToolKeys:string[]};
type Agent={id:number;templateKey:string;name:string;mission:string;enabled:boolean;projectKeys:string[];allowedToolKeys:string[];allowRag:boolean;allowApprovedMemory:boolean;allowScheduler:boolean};
type Run={id:number;agentId:number;projectKey:string;objective:string;status:string;approvalsCreated:number[];result:string|null;startedAt:string;completedAt:string|null};
type Tool={toolKey:string;riskLevel:string;enabled:boolean};
const base=(import.meta.env.VITE_API_BASE_URL||"http://localhost:3001").replace(/\/$/,"");
async function api<T>(path:string,body?:unknown):Promise<T>{const response=await fetch(`${base}${path}`,body===undefined?{}:{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});const data=await response.json();if(!response.ok)throw new Error(data.error||`HTTP ${response.status}`);return data as T;}
const empty={templateKey:"brand",name:"",description:"",mission:"",projectKeys:[] as string[],allowedToolKeys:[] as string[],deniedToolKeys:[] as string[],allowRag:true,allowApprovedMemory:true,allowScheduler:false,modelMode:"default",responseMode:"concise",enabled:false};
export function AgentsPanel({projects}:{projects:Project[]}){
 const [templates,setTemplates]=useState<Template[]>([]),[tools,setTools]=useState<Tool[]>([]),[agents,setAgents]=useState<Agent[]>([]),[runs,setRuns]=useState<Run[]>([]),[status,setStatus]=useState<{enabledAgents:number;activeRuns:number;waitingApprovals:number}|null>(null);
 const [draft,setDraft]=useState(empty),[preview,setPreview]=useState(false),[runPreview,setRunPreview]=useState<Record<string,unknown>|null>(null),[notice,setNotice]=useState(""),[busy,setBusy]=useState(false);
 const [selected,setSelected]=useState<number|null>(null),[projectKey,setProjectKey]=useState(""),[objective,setObjective]=useState(""),[toolKey,setToolKey]=useState(""),[toolArgs,setToolArgs]=useState("{}");
 const refresh=useCallback(async()=>{try{const [a,t,r,s,tl]=await Promise.all([api<{agents:Agent[]}>("/agents"),api<{templates:Template[]}>("/agents/templates"),api<{runs:Run[]}>("/agents/runs"),api<typeof status>("/agents/status"),api<{tools:Tool[]}>("/tools")]);setAgents(a.agents);setTemplates(t.templates);setRuns(r.runs);setStatus(s);setTools(tl.tools);}catch(e){setNotice(e instanceof Error?e.message:"Agents unavailable.");}},[]);
 useEffect(()=>{void refresh();},[refresh]);
 const current=agents.find(a=>a.id===selected);
 const definition=()=>({...draft,agentKey:draft.name.toLowerCase().trim().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,""),description:draft.description||draft.mission});
 const runTools=()=>{if(!toolKey)return [];let args;try{args=JSON.parse(toolArgs);if(!args||typeof args!=="object"||Array.isArray(args))throw Error();}catch{throw new Error("Tool arguments must be a JSON object.");}return [{toolKey,args}];};
 async function perform(work:()=>Promise<void>){setBusy(true);setNotice("");try{await work();}catch(e){setNotice(e instanceof Error?e.message:"Agent operation failed.");}finally{setBusy(false);}}
 const previewAgent=(e:FormEvent)=>{e.preventDefault();void perform(async()=>{await api("/agents/preview",definition());setPreview(true);});};
 const requestCreate=()=>void perform(async()=>{const v=await api<{request:{id:number}}>("/agents/requests",{action:"create",agent:definition()});setNotice(`Creation request #${v.request.id} is waiting for approval.`);setPreview(false);await refresh();});
 const change=(id:number,action:string)=>void perform(async()=>{const v=await api<{request:{id:number}}>("/agents/requests",{id,action});setNotice(`${action} request #${v.request.id} is waiting for approval.`);await refresh();});
 const previewRun=(e:FormEvent)=>{e.preventDefault();void perform(async()=>{const v=await api<{preview:Record<string,unknown>}>("/agents/run/preview",{agentId:selected,projectKey,objective,toolRequests:runTools()});setRunPreview(v.preview);});};
 const start=()=>void perform(async()=>{const v=await api<{run:Run}>(`/agents/${selected}/run`,{projectKey,objective,toolRequests:runTools()});setNotice(`Run #${v.run.id}: ${v.run.status}.`);setRunPreview(null);await refresh();});
 return <div className="space-y-4">
 <section className="panel"><p className="eyebrow">Agent status</p><h2 className="section-title">Project-specific agents</h2><p className="section-copy">User-triggered local workers with explicit project and tool scope.</p><div className="mt-4 flex flex-wrap gap-2"><span className="badge">{status?.enabledAgents??0} enabled</span><span className="badge">{status?.activeRuns??0} active</span><span className="badge badge-warn">{status?.waitingApprovals??0} waiting approval</span></div>{notice&&<p className="notice mt-4">{notice}</p>}</section>
 <section className="panel"><p className="eyebrow">Agent templates</p><div className="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-5">{templates.map(t=><button key={t.templateKey} className="queue-item text-left" onClick={()=>{setDraft({...empty,templateKey:t.templateKey,name:t.name,description:t.mission,mission:t.mission,allowedToolKeys:t.suggestedToolKeys});setPreview(false);}}><strong className="text-sm text-white">{t.name}</strong><p className="meta mb-0">{t.mission}</p></button>)}</div></section>
 <div className="grid gap-4 xl:grid-cols-2"><section className="panel"><p className="eyebrow">Create agent</p><h2 className="section-title">Define scope</h2><form className="mt-4 space-y-3" onSubmit={previewAgent}><select className="field" value={draft.templateKey} onChange={e=>{const t=templates.find(x=>x.templateKey===e.target.value);setDraft({...empty,templateKey:e.target.value,name:t?.name??"",description:t?.mission??"",mission:t?.mission??"",allowedToolKeys:t?.suggestedToolKeys??[]});setPreview(false);}}>{templates.map(t=><option key={t.templateKey} value={t.templateKey}>{t.name}</option>)}</select><input className="field" required placeholder="Name" value={draft.name} onChange={e=>setDraft({...draft,name:e.target.value})}/><input className="field" placeholder="Description" value={draft.description} onChange={e=>setDraft({...draft,description:e.target.value})}/><textarea className="field min-h-24" required placeholder="Mission" value={draft.mission} onChange={e=>setDraft({...draft,mission:e.target.value})}/><div><p className="meta">Projects — select explicitly</p><div className="flex flex-wrap gap-3">{projects.map(p=><label key={p.projectKey} className="text-sm text-slate-300"><input type="checkbox" checked={draft.projectKeys.includes(p.projectKey)} onChange={e=>setDraft({...draft,projectKeys:e.target.checked?[...draft.projectKeys,p.projectKey]:draft.projectKeys.filter(x=>x!==p.projectKey)})}/> {p.name}</label>)}</div></div><div><p className="meta">Allowed tools</p><div className="max-h-40 overflow-auto grid gap-1 sm:grid-cols-2">{tools.filter(t=>t.enabled&&!t.toolKey.startsWith("agents.")&&t.riskLevel!=="high_risk").map(t=><label key={t.toolKey} className="text-xs text-slate-300"><input type="checkbox" checked={draft.allowedToolKeys.includes(t.toolKey)} onChange={e=>setDraft({...draft,allowedToolKeys:e.target.checked?[...draft.allowedToolKeys,t.toolKey]:draft.allowedToolKeys.filter(x=>x!==t.toolKey)})}/> {t.toolKey} <span className="text-slate-500">{t.riskLevel}</span></label>)}</div></div><div className="flex flex-wrap gap-3 text-sm text-slate-300">{([ ["allowRag","RAG"],["allowApprovedMemory","Approved memory"],["allowScheduler","Scheduler proposals"]] as const).map(([key,label])=><label key={key}><input type="checkbox" checked={draft[key]} onChange={e=>setDraft({...draft,[key]:e.target.checked})}/> {label}</label>)}</div><div className="grid grid-cols-2 gap-2"><select className="field" value={draft.modelMode} onChange={e=>setDraft({...draft,modelMode:e.target.value})}><option value="default">Default model</option><option value="fast">Fast model</option></select><select className="field" value={draft.responseMode} onChange={e=>setDraft({...draft,responseMode:e.target.value})}><option value="concise">Concise</option><option value="detailed">Detailed</option></select></div><button className="button" disabled={busy}>Preview agent</button></form>{preview&&<div className="queue-item mt-4"><p className="meta">Creation preview · {draft.templateKey}</p><p className="text-sm text-white">{draft.name} · {draft.projectKeys.join(", ")}</p><p className="text-sm text-slate-300">{draft.mission}</p><p className="meta">Tools: {draft.allowedToolKeys.join(", ")||"none"} · RAG {draft.allowRag?"on":"off"} · memory {draft.allowApprovedMemory?"on":"off"} · scheduler {draft.allowScheduler?"on":"off"}</p><p className="meta">Model: {draft.modelMode} · response: {draft.responseMode} · actions require approval</p><button className="button mt-2" disabled={busy} onClick={requestCreate}>Request creation approval</button></div>}</section>
 <section className="panel"><p className="eyebrow">Agent cards</p><h2 className="section-title">Configured agents</h2><div className="mt-4 space-y-2">{agents.map(a=><article className="queue-item" key={a.id}><div className="flex items-center justify-between gap-2"><strong className="text-sm text-white">{a.name}</strong><span className={`badge ${a.enabled?"badge-ok":"badge-warn"}`}>{a.enabled?"Enabled":"Disabled"}</span></div><p className="meta">{a.templateKey} · {a.projectKeys.join(", ")} · {a.allowedToolKeys.length} allowed tools</p><p className="meta">RAG {a.allowRag?"on":"off"} · memory {a.allowApprovedMemory?"on":"off"} · scheduler {a.allowScheduler?"on":"off"} · last run {runs.find(x=>x.agentId===a.id)?.startedAt??"never"}</p><div className="flex gap-2"><button className="button" disabled={busy||!a.enabled} onClick={()=>{setSelected(a.id);setProjectKey(a.projectKeys[0]??"");setObjective("");setRunPreview(null);setToolKey("");}}>Run</button><button className="button" disabled={busy} onClick={()=>change(a.id,a.enabled?"disable":"enable")}>{a.enabled?"Request disable":"Request enable"}</button><button className="button" disabled={busy} onClick={()=>change(a.id,"delete")}>Request delete</button></div></article>)}{!agents.length&&<p className="empty">No agents created. Templates are inactive.</p>}</div>{current&&<form className="mt-6 space-y-3" onSubmit={previewRun}><p className="eyebrow">Run {current.name}</p><select className="field" value={projectKey} onChange={e=>setProjectKey(e.target.value)}>{current.projectKeys.map(k=><option key={k} value={k}>{projects.find(p=>p.projectKey===k)?.name??k}</option>)}</select><textarea className="field min-h-24" required placeholder="Objective" value={objective} onChange={e=>setObjective(e.target.value)}/><select className="field" value={toolKey} onChange={e=>setToolKey(e.target.value)}><option value="">No tool request</option>{current.allowedToolKeys.map(k=><option key={k} value={k}>{k}</option>)}</select>{toolKey&&<textarea className="field font-mono text-xs" value={toolArgs} onChange={e=>setToolArgs(e.target.value)} aria-label="Structured tool arguments"/>}<button className="button" disabled={busy}>Preview run</button>{runPreview&&<div className="queue-item"><p className="meta">Run preview · {projectKey}</p><pre className="overflow-auto text-xs text-slate-300">{JSON.stringify(runPreview,null,2)}</pre><button className="button mt-2" type="button" disabled={busy} onClick={start}>Start bounded run</button></div>}</form>}</section></div>
 <ApprovalHub onChanged={()=>void refresh()}/><section className="panel"><p className="eyebrow">Run history</p><div className="mt-3 space-y-2">{runs.map(run=><article className="queue-item" key={run.id}><div className="flex justify-between gap-2"><strong className="text-sm text-white">#{run.id} {run.objective}</strong><span className={`badge ${run.status==="waiting_approval"?"badge-warn":""}`}>{run.status}</span></div><p className="meta">{run.projectKey} · agent #{run.agentId} · {run.startedAt} {run.completedAt?`→ ${run.completedAt}`:""}</p>{run.approvalsCreated.length>0&&<p className="meta">Approval requests: {run.approvalsCreated.map(x=>`#${x}`).join(", ")}</p>}{run.result&&<p className="whitespace-pre-wrap text-sm text-slate-300">{run.result}</p>}</article>)}{!runs.length&&<p className="empty">No runs yet.</p>}</div></section>
 </div>;
}
