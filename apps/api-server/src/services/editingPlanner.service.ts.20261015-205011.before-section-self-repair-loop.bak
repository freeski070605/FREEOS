import { config } from "../config";
import { adobeService } from "./adobe.service";
import { generateWithOllama } from "./ollama.service";
import { bootstrapEditingAcademy, buildEditingKnowledgeContext } from "./editingAcademy.service";

type JsonObject = Record<string, unknown>;

export interface EditingPlannerClipInput {
  id: string;
  path: string;
  timelineOffsetSeconds?: number;
  exclude?: boolean;
}

export interface EditingPlannerRequest {
  audioPath: string;
  clips: EditingPlannerClipInput[];
  durationSeconds?: number;
  project?: string;
  sequence?: string;
  userIntent?: string;
  sampleFps?: number;
}

export interface EditingDecision {
  start: number;
  end: number;
  clipId: string;
  action: "cut" | "hold" | "punch-in";
  confidence: number;
  rationale: string;
}

export interface EditingPlan {
  version: string;
  durationSeconds: number;
  creativeSummary: string;
  decisions: EditingDecision[];
  cautions: string[];
  evidence: {
    audioAnalysisVersion?: string;
    videoAnalysisVersions: Record<string, string | undefined>;
    editingKnowledgeUnits?: number;
    editingKnowledgeGap?: boolean;
    plannerMode?: string;
    cameraProfileCount?: number;
    assemblyReviewApplied?: boolean;
    assemblyReviewFailure?: string;
    assemblyBoundaryPrunes?: number;
  };
}

interface CreativeBrief {
  creativeSummary: string;
  principles: string[];
  cautions: string[];
}
interface CameraProfile {
  clipId: string;
  shotCharacter: string;
  framingCharacter: string;
  motionCharacter: string;
  subjectVisibility: string;
  strengths: string[];
  cautions: string[];
  confidence: number;
}

const creativeBriefSchema: JsonObject = {
  type: "object",
  additionalProperties: false,
  required: ["creativeSummary", "principles", "cautions"],
  properties: {
    creativeSummary: { type: "string", maxLength: 2400 },
    principles: { type: "array", maxItems: 12, items: { type: "string", maxLength: 220 } },
    cautions: { type: "array", maxItems: 20, items: { type: "string", maxLength: 220 } },
  },
};

function buildCameraProfileSchema(clipIds: string[]): JsonObject {
  const variants = clipIds.map((clipId) => ({
    type: "object",
    additionalProperties: false,
    required: ["clipId", "shotCharacter", "framingCharacter", "motionCharacter", "subjectVisibility", "strengths", "cautions", "confidence"],
    properties: {
      clipId: { const: clipId },
      shotCharacter: { type: "string", maxLength: 180 },
      framingCharacter: { type: "string", maxLength: 180 },
      motionCharacter: { type: "string", maxLength: 180 },
      subjectVisibility: { type: "string", maxLength: 180 },
      strengths: { type: "array", maxItems: 6, items: { type: "string", maxLength: 180 } },
      cautions: { type: "array", maxItems: 6, items: { type: "string", maxLength: 180 } },
      confidence: { type: "number", minimum: 0, maximum: 1 },
    },
  }));

  return {
    type: "object",
    additionalProperties: false,
    required: ["profiles"],
    properties: {
      profiles: {
        type: "array",
        minItems: clipIds.length,
        maxItems: clipIds.length,
        items: { oneOf: variants },
      },
    },
  };
}
function buildAssemblyReviewSchema(end: number, videos: JsonObject[]): JsonObject {
  const step = 0.5;

  const openingVariants = videos.flatMap((video) => {
    const id = String(video.id);
    const availableStart = number(video.timelineAvailableStart, 0);
    const availableEnd = number(video.timelineAvailableEnd, end);
    if (availableStart > 0.001 || availableEnd <= 0.001) return [];
    return [{
      type: "object",
      additionalProperties: false,
      required: ["clipId", "action", "confidence"],
      properties: {
        clipId: { const: id },
        action: { type: "string", enum: ["cut", "hold", "punch-in"] },
        confidence: { type: "number", minimum: 0, maximum: 1 },
      },
    }];
  });

  const switchVariants = videos.flatMap((video) => {
    const id = String(video.id);
    const availableStart = Math.max(0, number(video.timelineAvailableStart, 0));
    const availableEnd = Math.min(end, number(video.timelineAvailableEnd, end));
    if (availableEnd <= availableStart) return [];
    const legalTimes: number[] = [];
    for (let t = 0.5; t < end; t += step) {
      const rounded = Number(t.toFixed(3));
      if (rounded + 0.001 >= availableStart && rounded < availableEnd - 0.001) legalTimes.push(rounded);
    }
    const exactStart = Number(availableStart.toFixed(3));
    if (exactStart > 0.001 && exactStart < availableEnd && !legalTimes.includes(exactStart)) legalTimes.push(exactStart);
    legalTimes.sort((a, b) => a - b);
    if (!legalTimes.length) return [];
    return [{
      type: "object",
      additionalProperties: false,
      required: ["at", "clipId", "action", "confidence"],
      properties: {
        at: { type: "number", enum: legalTimes },
        clipId: { const: id },
        action: { type: "string", enum: ["cut", "hold", "punch-in"] },
        confidence: { type: "number", minimum: 0, maximum: 1 },
      },
    }];
  });

  // A closing variant may only use a clip that can remain on screen through the assembly end.
  const closingVariants = videos.flatMap((video) => {
    const id = String(video.id);
    const availableStart = Math.max(0, number(video.timelineAvailableStart, 0));
    const availableEnd = number(video.timelineAvailableEnd, 0);
    if (availableEnd < end - 0.05) return [];
    const legalTimes: number[] = [];
    for (let t = 0.5; t < end; t += step) {
      const rounded = Number(t.toFixed(3));
      if (rounded + 0.001 >= availableStart) legalTimes.push(rounded);
    }
    const exactStart = Number(availableStart.toFixed(3));
    if (exactStart > 0.001 && exactStart < end && !legalTimes.includes(exactStart)) legalTimes.push(exactStart);
    legalTimes.sort((a, b) => a - b);
    if (!legalTimes.length) return [];
    return [{
      type: "object",
      additionalProperties: false,
      required: ["at", "clipId", "action", "confidence"],
      properties: {
        at: { type: "number", enum: legalTimes },
        clipId: { const: id },
        action: { type: "string", enum: ["cut", "hold", "punch-in"] },
        confidence: { type: "number", minimum: 0, maximum: 1 },
      },
    }];
  });

  if (!openingVariants.length) throw new Error('No video source is available at timeline start.');
  if (!closingVariants.length) throw new Error('No video source can cover the assembly ending.');

  return {
    type: "object",
    additionalProperties: false,
    required: ["opening", "switches", "closing"],
    properties: {
      opening: { oneOf: openingVariants },
      switches: {
        type: "array",
        maxItems: 31,
        items: { oneOf: switchVariants },
      },
      closing: { oneOf: closingVariants },
    },
  };
}
function buildBoundaryPruneSchema(candidateTimes: number[]): JsonObject {
  return {
    type: "object",
    additionalProperties: false,
    required: ["removeSwitches"],
    properties: {
      removeSwitches: {
        type: "array",
        uniqueItems: true,
        maxItems: candidateTimes.length,
        items: candidateTimes.length
          ? { type: "number", enum: candidateTimes }
          : { type: "number", enum: [] },
      },
    },
  };
}
function collectBoundaryTimes(
  value: unknown
): number[] {
  const result: number[] = [];

  const visit = (item: unknown): void => {
    if (
      typeof item === "number" &&
      Number.isFinite(item)
    ) {
      result.push(item);
      return;
    }

    if (
      !item ||
      typeof item !== "object" ||
      Array.isArray(item)
    ) {
      return;
    }

    const object = item as JsonObject;

    const keys = [
      "time",
      "start",
      "end",
      "startTime",
      "endTime",
      "startSeconds",
      "endSeconds",
    ];

    for (const key of keys) {
      const candidate = number(
        object[key],
        NaN
      );

      if (Number.isFinite(candidate)) {
        result.push(candidate);
      }
    }
  };

  if (Array.isArray(value)) {
    for (const item of value) {
      visit(item);
    }
  }
  else {
    visit(value);
  }

  return result;
}


function buildSectionEditMoments(
  audio: JsonObject,
  videos: JsonObject[],
  sectionStart: number,
  sectionEnd: number
): JsonObject[] {
  type Candidate = {
    at: number;
    score: number;
    reasons: string[];
  };

  const candidates: Candidate[] = [];

  const add = (
    rawAt: number,
    score: number,
    reason: string
  ): void => {
    if (!Number.isFinite(rawAt)) {
      return;
    }

    const at = Number(
      rawAt.toFixed(3)
    );

    if (
      at <= sectionStart + 0.15 ||
      at >= sectionEnd - 0.15
    ) {
      return;
    }

    candidates.push({
      at,
      score,
      reasons: [reason],
    });
  };


  /*
   * Exact measured transients.
   */
  const transientMoments =
    Array.isArray(audio.transientMoments)
      ? audio.transientMoments as JsonObject[]
      : [];

  const sectionTransients =
    transientMoments.filter((item) => {
      const at = number(item.time, NaN);

      return (
        Number.isFinite(at) &&
        at > sectionStart + 0.15 &&
        at < sectionEnd - 0.15
      );
    });

  const maxTransientStrength =
    sectionTransients.reduce(
      (maximum, item) =>
        Math.max(
          maximum,
          number(item.strength, 0)
        ),
      0
    );

  for (const transient of sectionTransients) {
    const strength = number(
      transient.strength,
      0
    );

    const normalized =
      maxTransientStrength > 0
        ? strength / maxTransientStrength
        : 0;

    add(
      number(transient.time, NaN),
      7 + normalized * 4,
      `audio transient strength=${strength.toFixed(3)}`
    );
  }


  /*
   * Downbeats are deliberately low priority.
   * They must not become another rhythmic grid.
   */
  for (
    const at of collectBoundaryTimes(
      audio.downbeats
    )
  ) {
    add(
      at,
      2.5,
      "measured downbeat"
    );
  }


  /*
   * Measured section boundaries.
   * No invented verse/chorus labels.
   */
  for (
    const at of collectBoundaryTimes(
      audio.sections
    )
  ) {
    add(
      at,
      9,
      "measured audio section boundary"
    );
  }


  /*
   * Measured silence boundaries.
   */
  for (
    const at of collectBoundaryTimes(
      audio.silenceRegions
    )
  ) {
    add(
      at,
      9.5,
      "measured silence boundary"
    );
  }


  /*
   * Exact visual scene/motion evidence.
   */
  for (const video of videos) {
    const clipId = String(video.id);

    const moments =
      Array.isArray(video.editMoments)
        ? video.editMoments as JsonObject[]
        : [];

    for (const moment of moments) {
      const at = number(
        moment.time,
        NaN
      );

      const type =
        typeof moment.type === "string"
          ? moment.type
          : "visual-change";

      const strength = number(
        moment.strength,
        0
      );

      const score =
        type === "scene-change"
          ? 8 + Math.min(3, strength * 3)
          : 5 + Math.min(2, strength * 2);

      add(
        at,
        score,
        `${clipId} ${type} strength=${strength.toFixed(3)}`
      );
    }


    /*
     * Physical media boundaries are valid editing evidence.
     */
    add(
      number(
        video.timelineAvailableStart,
        NaN
      ),
      10,
      `${clipId} source becomes available`
    );

    add(
      number(
        video.timelineAvailableEnd,
        NaN
      ),
      10,
      `${clipId} source availability ends`
    );
  }


  /*
   * Merge near-simultaneous evidence.
   */
  const sorted =
    candidates.sort(
      (a, b) =>
        a.at - b.at
    );

  const merged: Candidate[] = [];

  for (const candidate of sorted) {
    const previous = merged.at(-1);

    if (
      previous &&
      Math.abs(
        previous.at - candidate.at
      ) <= 0.30
    ) {
      previous.reasons.push(
        ...candidate.reasons
      );

      if (
        candidate.score >
        previous.score
      ) {
        previous.at = candidate.at;
        previous.score = candidate.score;
      }
      else {
        previous.score = Math.max(
          previous.score,
          candidate.score
        );
      }

      continue;
    }

    merged.push({
      at: candidate.at,
      score: candidate.score,
      reasons: [...candidate.reasons],
    });
  }


  /*
   * Keep strongest editorial opportunities only.
   *
   * The model may use NONE, SOME, or MANY of these.
   */
  return merged
    .sort(
      (a, b) =>
        b.score - a.score
    )
    .slice(0, 32)
    .sort(
      (a, b) =>
        a.at - b.at
    )
    .map((item) => ({
      at: Number(
        item.at.toFixed(3)
      ),
      score: Number(
        item.score.toFixed(3)
      ),
      reasons: item.reasons.slice(0, 6),
    }));
}


function buildSectionPlanSchema(
  sectionStart: number,
  sectionEnd: number,
  videos: JsonObject[],
  candidateTimes: number[]
): JsonObject {
  const uniqueCandidateTimes =
    Array.from(
      new Set(
        candidateTimes
          .filter(
            (value) =>
              Number.isFinite(value) &&
              value > sectionStart + 0.001 &&
              value < sectionEnd - 0.001
          )
          .map(
            (value) =>
              Number(value.toFixed(3))
          )
      )
    )
    .sort(
      (a, b) =>
        a - b
    );


  const openingVariants =
    videos.flatMap((video) => {
      const id = String(video.id);

      const availableStart = number(
        video.timelineAvailableStart,
        sectionStart
      );

      const availableEnd = number(
        video.timelineAvailableEnd,
        sectionEnd
      );

      if (
        availableStart > sectionStart + 0.001 ||
        availableEnd <= sectionStart + 0.001
      ) {
        return [];
      }

      return [{
        type: "object",
        additionalProperties: false,

        required: [
          "clipId",
          "action",
          "confidence",
          "rationale",
        ],

        properties: {
          clipId: {
            const: id,
          },

          action: {
            type: "string",
            enum: [
              "cut",
              "hold",
              "punch-in",
            ],
          },

          confidence: {
            type: "number",
            minimum: 0,
            maximum: 1,
          },

          rationale: {
            type: "string",
            maxLength: 180,
          },
        },
      }];
    });


  const switchVariants =
    videos.flatMap((video) => {
      const id = String(video.id);

      const availableStart = Math.max(
        sectionStart,
        number(
          video.timelineAvailableStart,
          sectionStart
        )
      );

      const availableEnd = Math.min(
        sectionEnd,
        number(
          video.timelineAvailableEnd,
          sectionEnd
        )
      );

      if (
        availableEnd <= availableStart
      ) {
        return [];
      }

      /*
       * Only evidence-backed moments can become switchpoints.
       * No synthetic half-second grid.
       */
      const legalTimes =
        uniqueCandidateTimes.filter(
          (at) =>
            at + 0.001 >= availableStart &&
            at < availableEnd - 0.001
        );


      /*
       * Exact source availability starts remain legal.
       */
      const exactStart = Number(
        availableStart.toFixed(3)
      );

      if (
        exactStart > sectionStart + 0.001 &&
        exactStart < availableEnd &&
        !legalTimes.includes(exactStart)
      ) {
        legalTimes.push(exactStart);
      }

      legalTimes.sort(
        (a, b) =>
          a - b
      );

      if (!legalTimes.length) {
        return [];
      }

      return [{
        type: "object",
        additionalProperties: false,

        required: [
          "at",
          "clipId",
          "action",
          "confidence",
          "rationale",
        ],

        properties: {
          at: {
            type: "number",
            enum: legalTimes,
          },

          clipId: {
            const: id,
          },

          action: {
            type: "string",
            enum: [
              "cut",
              "hold",
              "punch-in",
            ],
          },

          confidence: {
            type: "number",
            minimum: 0,
            maximum: 1,
          },

          rationale: {
            type: "string",
            maxLength: 180,
          },
        },
      }];
    });


  if (!openingVariants.length) {
    throw new Error(
      `No video source is available at section start ${sectionStart}.`
    );
  }

  return {
    type: "object",
    additionalProperties: false,

    required: [
      "opening",
      "switches",
      "cautions",
    ],

    properties: {
      opening: {
        oneOf: openingVariants,
      },

      switches:
        switchVariants.length
          ? {
              type: "array",
              maxItems: Math.min(
                19,
                uniqueCandidateTimes.length
              ),
              items: {
                oneOf: switchVariants,
              },
            }
          : {
              type: "array",
              maxItems: 0,
            },

      cautions: {
        type: "array",
        maxItems: 10,

        items: {
          type: "string",
          maxLength: 220,
        },
      },
    },
  };
}
function asObject(value: unknown, label: string): JsonObject {
  if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error(`${label} must be an object.`);
  return value as JsonObject;
}

function number(value: unknown, fallback = 0): number {
  return typeof value === "number" && Number.isFinite(value) ? value : fallback;
}

function mean(values: number[]): number | null {
  const finite = values.filter(Number.isFinite);
  return finite.length ? finite.reduce((a, b) => a + b, 0) / finite.length : null;
}
function dominantString(values: unknown[]): string | null {
  const strings = values.filter((value): value is string => typeof value === "string" && value.length > 0);
  if (!strings.length) return null;
  const counts = new Map<string, number>();
  for (const value of strings) counts.set(value, (counts.get(value) ?? 0) + 1);
  return [...counts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] ?? null;
}

function compactAudio(raw: unknown): JsonObject {
  const a = asObject(raw, "audio analysis");

  const energy =
    Array.isArray(a.energyCurve)
      ? a.energyCurve as JsonObject[]
      : [];

  const transients =
    Array.isArray(a.transients)
      ? a.transients as JsonObject[]
      : [];

  const beats =
    Array.isArray(a.beats)
      ? a.beats as JsonObject[]
      : [];

  const windowSeconds = 4;
  const duration = number(a.durationSeconds, 0);
  const windows: JsonObject[] = [];

  for (let start = 0; start < duration; start += windowSeconds) {
    const end = Math.min(duration, start + windowSeconds);

    const energies = energy
      .filter(
        (e) =>
          number(e.time, -1) >= start &&
          number(e.time, -1) < end
      )
      .map((e) => number(e.rms, NaN));

    const peaks = energy
      .filter(
        (e) =>
          number(e.time, -1) >= start &&
          number(e.time, -1) < end
      )
      .map((e) => number(e.peak, NaN));

    const windowTransients = transients.filter(
      (e) =>
        number(e.time, -1) >= start &&
        number(e.time, -1) < end
    );

    const windowBeats = beats.filter(
      (e) =>
        number(e.time, -1) >= start &&
        number(e.time, -1) < end
    );

    windows.push({
      start,
      end,
      energyMean: mean(energies),
      peakMean: mean(peaks),
      transientCount: windowTransients.length,
      strongestTransient:
        windowTransients.reduce(
          (m, e) =>
            Math.max(
              m,
              number(e.strength, 0)
            ),
          0
        ),
      beatCount: windowBeats.length,
    });
  }

  /*
   * Preserve exact measured transient times.
   *
   * These are candidate editorial events, NOT automatic cuts.
   */
  const transientMoments = transients
    .map((item) => ({
      time: number(item.time, NaN),
      strength: number(item.strength, 0),
    }))
    .filter(
      (item) =>
        Number.isFinite(item.time) &&
        item.time >= 0 &&
        item.time <= duration
    )
    .sort((a, b) => b.strength - a.strength)
    .slice(0, 256)
    .sort((a, b) => a.time - b.time);

  /*
   * Preserve exact beats as low-priority evidence.
   * They are deliberately not treated as a required cut grid.
   */
  const beatMoments = beats
    .map((item) => ({
      time: number(item.time, NaN),
      strength: number(item.strength, 0),
    }))
    .filter(
      (item) =>
        Number.isFinite(item.time) &&
        item.time >= 0 &&
        item.time <= duration
    )
    .slice(0, 512);

  return {
    durationSeconds: a.durationSeconds,
    tempo: a.tempo,
    downbeats: Array.isArray(a.downbeats) ? a.downbeats : [],
    sections: Array.isArray(a.sections) ? a.sections : [],
    loudness: a.loudness,
    silenceRegions: a.silenceRegions,
    intro: a.intro,
    outro: a.outro,
    windows,
    transientMoments,
    beatMoments,
    analysisVersion: a.analysisVersion,
  };
}
function compactVideo(raw: unknown, input: EditingPlannerClipInput): JsonObject {
  const v = asObject(raw, `video analysis for ${input.id}`);
  const timeline = Array.isArray(v.timeline) ? v.timeline as JsonObject[] : [];
  const duration = number(v.durationSeconds, 0);
  const offset = input.timelineOffsetSeconds ?? 0;
  const windowSeconds = 4;
  const windows: JsonObject[] = [];
  for (let start = 0; start < duration; start += windowSeconds) {
    const end = Math.min(duration, start + windowSeconds);
    const frames = timeline.filter((f) => number(f.time, -1) >= start && number(f.time, -1) < end);
    if (!frames.length) continue;
    const faces = frames.filter((f) => number(f.faceCount, 0) > 0);
    const largestFaces = faces.map((f) => f.largestFace).filter((f): f is JsonObject => !!f && typeof f === "object" && !Array.isArray(f));
    windows.push({
      sourceStart: start,
      sourceEnd: end,
      timelineStart: start + offset,
      timelineEnd: end + offset,
      sharpness: mean(frames.map((f) => number(f.sharpness, NaN))),
      brightness: mean(frames.map((f) => number(f.brightness, NaN))),
      motion: mean(frames.map((f) => number(f.motion, NaN))),
      sceneChangeMax: frames.reduce((m, f) => Math.max(m, number(f.sceneChange, 0)), 0),
      facePresence: faces.length / frames.length,
      multiFacePresence: frames.filter((f) => number(f.faceCount, 0) > 1).length / frames.length,
      primaryFaceArea: mean(largestFaces.map((f) => number(f.areaRatio, NaN))),
      primaryFaceCenterX: mean(largestFaces.map((f) => number(f.centerX, NaN))),
      primaryFaceCenterY: mean(largestFaces.map((f) => number(f.centerY, NaN))),
      underexposedFraction: mean(frames.map((f) => number(f.underexposedFraction, NaN))),
      overexposedFraction: mean(frames.map((f) => number(f.overexposedFraction, NaN))),
      personPresence: frames.filter((f) => number(f.personCount, 0) > 0).length / frames.length,
      personCountMean: mean(frames.map((f) => number(f.personCount, NaN))),
      subjectCountMean: mean(frames.map((f) => number(f.subjectCountEstimate, NaN))),
      primaryPersonArea: mean(frames.map((f) => {
        const person = f.largestPerson;
        return person && typeof person === "object" && !Array.isArray(person) ? number((person as JsonObject).areaRatio, NaN) : NaN;
      })),
      globalMotion: mean(frames.map((f) => number(f.globalMotion, NaN))),
      localMotion: mean(frames.map((f) => number(f.localMotion, NaN))),
      shotScale: dominantString(frames.map((f) => f.shotScale)),
      shotScaleConfidence: mean(frames.map((f) => number(f.shotScaleConfidence, NaN))),
      framingRole: dominantString(frames.map((f) => f.framingRole)),
      framingRoleConfidence: mean(frames.map((f) => number(f.framingRoleConfidence, NaN))),
      motionRole: dominantString(frames.map((f) => f.motionRole)),
      motionRoleConfidence: mean(frames.map((f) => number(f.motionRoleConfidence, NaN))),
    });
  }
  /*
   * Preserve exact visual changes from the analyzer timeline.
   *
   * These become editorial opportunities, not automatic switches.
   */
  type VisualMetric = {
    timelineTime: number;
    sceneChange: number;
    motionDelta: number;
  };

  type VisualEditMoment = {
    time: number;
    type: "scene-change" | "motion-shift";
    strength: number;
  };

  /*
   * Preserve exact visual changes from the analyzer timeline.
   *
   * These are measured editorial opportunities.
   * They do NOT force FREEOS to cut.
   */
  const visualMetrics: VisualMetric[] =
    timeline
      .map(
        (
          frame: JsonObject,
          index: number
        ): VisualMetric => {
          const previous: JsonObject | undefined =
            index > 0
              ? timeline[index - 1]
              : undefined;

          const sourceTime: number =
            number(
              frame.time,
              NaN
            );

          const sceneChange: number =
            number(
              frame.sceneChange,
              0
            );

          const motion: number =
            number(
              frame.motion,
              0
            );

          const previousMotion: number =
            previous
              ? number(
                  previous.motion,
                  motion
                )
              : motion;

          return {
            timelineTime:
              sourceTime + offset,

            sceneChange,

            motionDelta:
              Math.abs(
                motion -
                previousMotion
              ),
          };
        }
      )
      .filter(
        (
          item: VisualMetric
        ): boolean =>
          Number.isFinite(
            item.timelineTime
          )
      );

  const sceneValues: number[] =
    visualMetrics
      .map(
        (
          item: VisualMetric
        ): number =>
          item.sceneChange
      )
      .filter(
        (
          value: number
        ): boolean =>
          Number.isFinite(value)
      )
      .sort(
        (
          a: number,
          b: number
        ): number =>
          a - b
      );

  const motionValues: number[] =
    visualMetrics
      .map(
        (
          item: VisualMetric
        ): number =>
          item.motionDelta
      )
      .filter(
        (
          value: number
        ): boolean =>
          Number.isFinite(value)
      )
      .sort(
        (
          a: number,
          b: number
        ): number =>
          a - b
      );

  const percentileValue = (
    values: number[],
    percentile: number
  ): number => {
    if (!values.length) {
      return 0;
    }

    const index: number =
      Math.max(
        0,
        Math.min(
          values.length - 1,
          Math.floor(
            (values.length - 1) *
            percentile
          )
        )
      );

    return values[index];
  };

  const sceneThreshold: number =
    Math.max(
      0.08,
      percentileValue(
        sceneValues,
        0.88
      )
    );

  const motionThreshold: number =
    Math.max(
      0.03,
      percentileValue(
        motionValues,
        0.90
      )
    );

  const visualEditMoments: VisualEditMoment[] =
    visualMetrics
      .flatMap(
        (
          item: VisualMetric
        ): VisualEditMoment[] => {
          const moments: VisualEditMoment[] = [];

          if (
            item.sceneChange >=
            sceneThreshold
          ) {
            moments.push({
              time:
                Number(
                  item.timelineTime.toFixed(3)
                ),

              type:
                "scene-change",

              strength:
                item.sceneChange,
            });
          }

          if (
            item.motionDelta >=
            motionThreshold
          ) {
            moments.push({
              time:
                Number(
                  item.timelineTime.toFixed(3)
                ),

              type:
                "motion-shift",

              strength:
                item.motionDelta,
            });
          }

          return moments;
        }
      )
      .sort(
        (
          a: VisualEditMoment,
          b: VisualEditMoment
        ): number =>
          b.strength -
          a.strength
      )
      .slice(
        0,
        128
      )
      .sort(
        (
          a: VisualEditMoment,
          b: VisualEditMoment
        ): number =>
          a.time -
          b.time
      );

  return {
    id: input.id,
    timelineOffsetSeconds: offset,
    timelineAvailableStart: offset,
    timelineAvailableEnd: offset + duration,
    durationSeconds: v.durationSeconds,
    width: v.width,
    height: v.height,
    fps: v.fps,
    summary: v.summary,
    sceneChanges:
      Array.isArray(v.sceneChanges)
        ? (v.sceneChanges as unknown[]).slice(0, 100)
        : [],
    qualityFlags: v.qualityFlags,
    analysisVersion: v.analysisVersion,
    windows,
    editMoments: visualEditMoments,
  };
}
function parseCreativeBrief(text: string): CreativeBrief {
  const parsed = asObject(JSON.parse(text), "creative brief");
  return {
    creativeSummary: typeof parsed.creativeSummary === "string" ? parsed.creativeSummary.slice(0, 3000) : "",
    principles: Array.isArray(parsed.principles) ? parsed.principles.filter((v): v is string => typeof v === "string").slice(0, 12) : [],
    cautions: Array.isArray(parsed.cautions) ? parsed.cautions.filter((v): v is string => typeof v === "string").slice(0, 20) : [],
  };
}

function parseCameraProfiles(text: string, clipIds: string[]): CameraProfile[] {
  const parsed = asObject(JSON.parse(text), "camera profile response");
  const rawProfiles = Array.isArray(parsed.profiles) ? parsed.profiles : [];
  if (rawProfiles.length !== clipIds.length) {
    throw new Error(`FREEOS returned ${rawProfiles.length} camera profiles for ${clipIds.length} clips.`);
  }

  const allowed = new Set(clipIds);
  const seen = new Set<string>();
  const profiles = rawProfiles.map((item, index): CameraProfile => {
    const profile = asObject(item, `camera profile ${index}`);
    const clipId = typeof profile.clipId === "string" ? profile.clipId : "";
    if (!allowed.has(clipId)) throw new Error(`Camera profile ${index} references unknown clip '${clipId}'.`);
    if (seen.has(clipId)) throw new Error(`Camera profile duplicated clip '${clipId}'.`);
    seen.add(clipId);
    const strings = (value: unknown) => Array.isArray(value) ? value.filter((v): v is string => typeof v === "string").slice(0, 6) : [];
    return {
      clipId,
      shotCharacter: typeof profile.shotCharacter === "string" ? profile.shotCharacter.slice(0, 240) : "unknown",
      framingCharacter: typeof profile.framingCharacter === "string" ? profile.framingCharacter.slice(0, 240) : "unknown",
      motionCharacter: typeof profile.motionCharacter === "string" ? profile.motionCharacter.slice(0, 240) : "unknown",
      subjectVisibility: typeof profile.subjectVisibility === "string" ? profile.subjectVisibility.slice(0, 240) : "unknown",
      strengths: strings(profile.strengths),
      cautions: strings(profile.cautions),
      confidence: Math.max(0, Math.min(1, number(profile.confidence, 0.5))),
    };
  });

  for (const clipId of clipIds) if (!seen.has(clipId)) throw new Error(`Camera profile missing clip '${clipId}'.`);
  return profiles;
}
function parseAssemblyReview(text: string): { opening: unknown; switches: unknown[]; closing: unknown } {
  const parsed = asObject(JSON.parse(text), "assembly review");
  return {
    opening: parsed.opening,
    switches: Array.isArray(parsed.switches) ? parsed.switches : [],
    closing: parsed.closing,
  };
}

function validateAssemblyReview(raw: { opening: unknown; switches: unknown[]; closing: unknown }, allowedClipIds: Set<string>, end: number, videos: JsonObject[]): EditingDecision[] {
  const closing = asObject(raw.closing, "assembly closing");
  const closingAt = number(closing.at, NaN);
  const closingClipId = typeof closing.clipId === "string" ? closing.clipId : "";
  const closingAction = closing.action;
  if (!Number.isFinite(closingAt) || closingAt <= 0.001 || closingAt >= end) throw new Error('Assembly closing has invalid timing.');
  if (!allowedClipIds.has(closingClipId)) throw new Error(`Assembly closing references unknown clip '${closingClipId}'.`);
  if (closingAction !== "cut" && closingAction !== "hold" && closingAction !== "punch-in") throw new Error('Assembly closing has invalid action.');
  const closingVideo = videos.find((video) => String(video.id) === closingClipId);
  const closingAvailableStart = number(closingVideo?.timelineAvailableStart, 0);
  const closingAvailableEnd = number(closingVideo?.timelineAvailableEnd, 0);
  if (!closingVideo || closingAt < closingAvailableStart - 0.05 || closingAvailableEnd < end - 0.05) {
    throw new Error(`Assembly closing clip '${closingClipId}' cannot cover ${closingAt}-${end} (${closingAvailableStart}-${closingAvailableEnd}).`);
  }

  // The explicit closing is authoritative. Any ordinary switch at the same
  // timestamp or later is redundant/conflicting output from the model and is
  // discarded deterministically before validation. This does not make a new
  // creative choice; it enforces the review schema's closing contract.
  const earlier = raw.switches.filter((item) => {
    if (!item || typeof item !== "object" || Array.isArray(item)) return true;
    return number((item as JsonObject).at, NaN) < closingAt - 0.001;
  });

  const allSwitches = [...earlier, {
    at: closingAt,
    clipId: closingClipId,
    action: closingAction,
    confidence: number(closing.confidence, 0.5),
    rationale: "",
  }];
  return validateSectionSwitches(raw.opening, allSwitches, allowedClipIds, 0, end, videos);
}
function parseSectionPlan(text: string): { opening: unknown; switches: unknown[]; cautions: string[] } {
  const parsed = asObject(JSON.parse(text), "section plan");
  return {
    opening: parsed.opening,
    switches: Array.isArray(parsed.switches) ? parsed.switches : [],
    cautions: Array.isArray(parsed.cautions) ? parsed.cautions.filter((v): v is string => typeof v === "string") : [],
  };
}

function findCandidateMomentNear(
  candidateEditMoments: JsonObject[],
  at: number,
  tolerance = 0.01
): JsonObject | undefined {
  return candidateEditMoments
    .filter((moment) => {
      const candidateAt = number(
        moment.at,
        NaN
      );

      return (
        Number.isFinite(candidateAt) &&
        Math.abs(candidateAt - at) <= tolerance
      );
    })
    .sort(
      (a, b) =>
        Math.abs(number(a.at, 0) - at) -
        Math.abs(number(b.at, 0) - at)
    )[0];
}


function candidateReasonCount(
  moment: JsonObject | undefined
): number {
  if (!moment) {
    return 0;
  }

  return Array.isArray(moment.reasons)
    ? moment.reasons.filter(
        (reason) =>
          typeof reason === "string" &&
          reason.trim().length > 0
      ).length
    : 0;
}


function isStrongLocalEditMoment(
  moment: JsonObject | undefined
): boolean {
  if (!moment) {
    return false;
  }

  const score = number(
    moment.score,
    0
  );

  const reasons =
    candidateReasonCount(moment);

  return (
    score >= 10 ||
    (
      score >= 8.75 &&
      reasons >= 2
    )
  );
}


function sanitizeGroundedEditorialText(
  value: string
): string {
  return value
    .replace(
      /\bbacking\s+singers?\b/gi,
      "multiple detected faces"
    )
    .replace(
      /\bperformers?\b/gi,
      "visible subject"
    )
    .replace(
      /\bperformance\b/gi,
      "visual"
    )
    .replace(
      /\bgroup\s+(?:shot|performance|energy|context|view|visibility)\b/gi,
      "multi-face framing"
    )
    .replace(
      /\bgroup\b/gi,
      "multi-face"
    )
    .replace(
      /\bensemble\b/gi,
      "multi-face framing"
    )
    .replace(
      /\b(?:audience|crowd)\b/gi,
      "visible subjects"
    )
    .replace(
      /\b(?:vocal|vocals|lyric|lyrics|harmony|solo|instrumental|instrument|instruments|melody|melodic)\b/gi,
      "audio event"
    )
    .replace(
      /\b(?:verse|chorus|bridge|hook|pre-chorus|breakdown)\b/gi,
      "audio section"
    )
    .replace(
      /\s{2,}/g,
      " "
    )
    .trim();
}


function assertGroundedLocalRationale(
  rationale: string,
  at: number,
  sectionStart: number,
  sectionEnd: number,
  label: string
): void {
  const unsupported =
    /\b(?:performer|performers|performance|singer|singers|audience|crowd|ensemble|group|vocal|vocals|lyric|lyrics|chorus|verse|bridge|hook|harmony|solo|instrument|instruments|instrumental|melody|melodic)\b/i;

  if (
    rationale &&
    unsupported.test(rationale)
  ) {
    throw new Error(
      `${label} contains unsupported semantic language: '${rationale}'. Use neutral measured evidence only.`
    );
  }

  const timestampPattern =
    /(\d+(?:\.\d+)?)\s*(?:s|sec|secs|second|seconds)\b/gi;

  let match: RegExpExecArray | null;

  while (
    (match = timestampPattern.exec(rationale)) !== null
  ) {
    const referencedTime =
      Number(match[1]);

    if (
      !Number.isFinite(referencedTime)
    ) {
      continue;
    }

    if (
      referencedTime >= sectionStart - 0.1 &&
      referencedTime <= sectionEnd + 0.1 &&
      Math.abs(referencedTime - at) > 0.80
    ) {
      throw new Error(
        `${label} at ${at.toFixed(3)}s cites non-local timeline evidence at ${referencedTime.toFixed(3)}s.`
      );
    }
  }
}


function assertNoMechanicalCameraPingPong(
  points: Array<{
    at: number;
    clipId: string;
    rationale: string;
  }>,
  candidateEditMoments: JsonObject[]
): void {
  if (points.length < 3) {
    return;
  }

  /*
   * Ultra-short A -> B -> A.
   */
  for (
    let index = 0;
    index + 2 < points.length;
    index += 1
  ) {
    const a = points[index];
    const b = points[index + 1];
    const c = points[index + 2];

    if (
      a.clipId !== c.clipId ||
      a.clipId === b.clipId
    ) {
      continue;
    }

    if (
      b.rationale.startsWith("Availability repair:") ||
      c.rationale.startsWith("Availability repair:")
    ) {
      continue;
    }

    const middleDuration =
      c.at - b.at;

    if (
      middleDuration < 0.75
    ) {
      throw new Error(
        `Mechanical camera bounce detected: '${a.clipId}' -> '${b.clipId}' -> '${c.clipId}' with only ${middleDuration.toFixed(3)}s on the middle camera.`
      );
    }

    if (
      middleDuration < 2.0
    ) {
      const entryMoment =
        findCandidateMomentNear(
          candidateEditMoments,
          b.at
        );

      const exitMoment =
        findCandidateMomentNear(
          candidateEditMoments,
          c.at
        );

      if (
        !isStrongLocalEditMoment(entryMoment) ||
        !isStrongLocalEditMoment(exitMoment)
      ) {
        throw new Error(
          `Short A-B-A return at ${b.at.toFixed(3)}-${c.at.toFixed(3)} lacks strong local evidence at both transitions.`
        );
      }
    }
  }


  /*
   * Mechanical A-B-A-B.
   */
  for (
    let index = 0;
    index + 3 < points.length;
    index += 1
  ) {
    const p0 = points[index];
    const p1 = points[index + 1];
    const p2 = points[index + 2];
    const p3 = points[index + 3];

    const alternating =
      p0.clipId === p2.clipId &&
      p1.clipId === p3.clipId &&
      p0.clipId !== p1.clipId;

    if (!alternating) {
      continue;
    }

    if (
      p1.rationale.startsWith("Availability repair:") ||
      p2.rationale.startsWith("Availability repair:") ||
      p3.rationale.startsWith("Availability repair:")
    ) {
      continue;
    }

    const d1 = p1.at - p0.at;
    const d2 = p2.at - p1.at;
    const d3 = p3.at - p2.at;

    if (
      d1 > 8.5 ||
      d2 > 8.5 ||
      d3 > 8.5
    ) {
      continue;
    }

    const evidence1 =
      findCandidateMomentNear(
        candidateEditMoments,
        p1.at
      );

    const evidence2 =
      findCandidateMomentNear(
        candidateEditMoments,
        p2.at
      );

    const evidence3 =
      findCandidateMomentNear(
        candidateEditMoments,
        p3.at
      );

    const fullyCorroborated =
      isStrongLocalEditMoment(evidence1) &&
      isStrongLocalEditMoment(evidence2) &&
      isStrongLocalEditMoment(evidence3);

    if (!fullyCorroborated) {
      throw new Error(
        `Mechanical A-B-A-B alternation detected between '${p0.clipId}' and '${p1.clipId}' at ${p0.at.toFixed(3)}, ${p1.at.toFixed(3)}, ${p2.at.toFixed(3)}, ${p3.at.toFixed(3)}.`
      );
    }
  }
}


function sanitizeStructuredStrings<T>(
  value: T
): T {
  return JSON.parse(
    JSON.stringify(
      value,
      (_key, item) =>
        typeof item === "string"
          ? sanitizeGroundedEditorialText(item)
          : item
    )
  ) as T;
}

function validateSectionSwitches(
  openingRaw: unknown,
  raw: unknown[],
  allowedClipIds: Set<string>,
  sectionStart: number,
  sectionEnd: number,
  videos: JsonObject[],
  candidateEditMoments: JsonObject[] = [],
  previousClipId = ""
): EditingDecision[] {
  const opening =
    asObject(
      openingRaw,
      "section opening"
    );

  const openingClipId =
    typeof opening.clipId === "string"
      ? opening.clipId
      : "";

  const openingAction =
    opening.action;

  if (
    !allowedClipIds.has(
      openingClipId
    )
  ) {
    throw new Error(
      `Section opening references unknown clip '${openingClipId}'.`
    );
  }

  if (
    openingAction !== "cut" &&
    openingAction !== "hold" &&
    openingAction !== "punch-in"
  ) {
    throw new Error(
      "Section opening has invalid action."
    );
  }

  const openingVideo =
    videos.find(
      (video) =>
        String(video.id) ===
        openingClipId
    );

  if (
    !openingVideo ||
    sectionStart <
      number(
        openingVideo.timelineAvailableStart,
        0
      ) - 0.01 ||
    sectionStart >=
      number(
        openingVideo.timelineAvailableEnd,
        0
      ) - 0.01
  ) {
    throw new Error(
      `Section opening clip '${openingClipId}' is unavailable at ${sectionStart}.`
    );
  }

  const openingRationale =
    typeof opening.rationale === "string"
      ? opening.rationale.slice(0, 500)
      : "";

  assertGroundedLocalRationale(
    openingRationale,
    sectionStart,
    sectionStart,
    sectionEnd,
    "Section opening"
  );


  /*
   * Internal planning boundaries cannot create camera changes.
   */
  if (
    sectionStart > 0.001 &&
    previousClipId
  ) {
    const previousVideo =
      videos.find(
        (video) =>
          String(video.id) ===
          previousClipId
      );

    const previousStillAvailable =
      Boolean(previousVideo) &&
      sectionStart >=
        number(
          previousVideo?.timelineAvailableStart,
          0
        ) - 0.01 &&
      sectionStart <
        number(
          previousVideo?.timelineAvailableEnd,
          0
        ) - 0.01;

    if (
      previousStillAvailable &&
      openingClipId !== previousClipId
    ) {
      throw new Error(
        `Internal section boundary ${sectionStart.toFixed(3)}s cannot create a new camera choice. Previous clip '${previousClipId}' remains available, so this section must open on '${previousClipId}'.`
      );
    }
  }


  const switches =
    raw
      .map(
        (item, index) => {
          const s =
            asObject(
              item,
              `section switch ${index}`
            );

          const at =
            number(
              s.at,
              NaN
            );

          const clipId =
            typeof s.clipId === "string"
              ? s.clipId
              : "";

          const action =
            s.action;

          if (
            !Number.isFinite(at) ||
            at <= sectionStart + 0.001 ||
            at >= sectionEnd
          ) {
            throw new Error(
              `Section switch ${index} has invalid timing.`
            );
          }

          if (
            !allowedClipIds.has(
              clipId
            )
          ) {
            throw new Error(
              `Section switch ${index} references unknown clip '${clipId}'.`
            );
          }

          if (
            action !== "cut" &&
            action !== "hold" &&
            action !== "punch-in"
          ) {
            throw new Error(
              `Section switch ${index} has invalid action.`
            );
          }

          /*
           * Section-planner calls pass real candidateEditMoments.
           * Legacy/global validation paths do not.
           *
           * Only enforce exact candidate membership when real
           * section-local evidence was supplied.
           */
          if (
            candidateEditMoments.length > 0
          ) {
            const candidateMoment =
              findCandidateMomentNear(
                candidateEditMoments,
                at
              );

            if (!candidateMoment) {
              throw new Error(
                `Section switch ${index} at ${at.toFixed(3)}s has no matching measured candidate edit moment.`
              );
            }
          }

          const rationale =
            typeof s.rationale === "string"
              ? s.rationale.slice(0, 500)
              : "";

          assertGroundedLocalRationale(
            rationale,
            at,
            sectionStart,
            sectionEnd,
            `Section switch ${index}`
          );

          return {
            at,
            clipId,

            action:
              action as EditingDecision["action"],

            confidence:
              Math.max(
                0,
                Math.min(
                  1,
                  number(
                    s.confidence,
                    0.5
                  )
                )
              ),

            rationale,
          };
        }
      )
      .sort(
        (a, b) =>
          a.at - b.at ||
          b.confidence - a.confidence
      );


  const unique =
    switches.filter(
      (item, index) =>
        index === 0 ||
        Math.abs(
          item.at -
          switches[index - 1].at
        ) > 0.001
    );


  const points = [
    {
      at: sectionStart,
      clipId: openingClipId,

      action:
        openingAction as EditingDecision["action"],

      confidence:
        Math.max(
          0,
          Math.min(
            1,
            number(
              opening.confidence,
              0.5
            )
          )
        ),

      rationale:
        openingRationale,
    },

    ...unique,
  ];


  /*
   * Preserve FREEOS creative choices while deterministically
   * repairing only unambiguous source overruns.
   */
  const repairedPoints =
    points.map(
      (point) => ({
        ...point,
      })
    );

  let repairIndex = 0;

  while (
    repairIndex <
    repairedPoints.length
  ) {
    const item =
      repairedPoints[
        repairIndex
      ];

    const plannedEnd =
      repairIndex + 1 <
      repairedPoints.length
        ? repairedPoints[
            repairIndex + 1
          ].at
        : sectionEnd;

    if (
      plannedEnd <= item.at
    ) {
      throw new Error(
        `Section point ${repairIndex} does not advance the timeline.`
      );
    }

    const video =
      videos.find(
        (candidate) =>
          String(candidate.id) ===
          item.clipId
      );

    const availableStart =
      number(
        video?.timelineAvailableStart,
        0
      );

    const availableEnd =
      number(
        video?.timelineAvailableEnd,
        0
      );

    if (
      !video ||
      item.at <
        availableStart - 0.05
    ) {
      throw new Error(
        `Section point ${repairIndex} starts '${item.clipId}' outside source availability (${item.at} vs ${availableStart}-${availableEnd}).`
      );
    }

    if (
      plannedEnd <=
      availableEnd + 0.05
    ) {
      repairIndex += 1;
      continue;
    }

    const repairAt =
      Math.floor(
        availableEnd * 1000
      ) / 1000;

    if (
      !Number.isFinite(repairAt) ||
      repairAt <= item.at + 0.001 ||
      repairAt >= plannedEnd
    ) {
      throw new Error(
        `Cannot safely repair source overrun for '${item.clipId}' at ${item.at}-${plannedEnd}; source ends at ${availableEnd}.`
      );
    }

    const legalContinuations =
      videos.filter(
        (candidate) => {
          const candidateId =
            String(candidate.id);

          const candidateStart =
            number(
              candidate.timelineAvailableStart,
              0
            );

          const candidateEnd =
            number(
              candidate.timelineAvailableEnd,
              0
            );

          return (
            candidateId !== item.clipId &&
            allowedClipIds.has(candidateId) &&
            repairAt >= candidateStart - 0.05 &&
            plannedEnd <= candidateEnd + 0.05
          );
        }
      );

    const plannedNext =
      repairIndex + 1 <
      repairedPoints.length
        ? repairedPoints[
            repairIndex + 1
          ]
        : null;

    let continuation:
      JsonObject |
      undefined;

    if (plannedNext) {
      continuation =
        legalContinuations.find(
          (candidate) =>
            String(candidate.id) ===
            plannedNext.clipId
        );
    }

    if (
      !continuation &&
      legalContinuations.length === 1
    ) {
      continuation =
        legalContinuations[0];
    }

    if (!continuation) {
      const candidateIds =
        legalContinuations.map(
          (candidate) =>
            String(candidate.id)
        );

      throw new Error(
        `Section point ${repairIndex} keeps '${item.clipId}' past source availability (${item.at}-${plannedEnd} vs ${availableStart}-${availableEnd}) and automatic repair is ${
          candidateIds.length === 0
            ? "impossible because no legal continuation exists"
            : `ambiguous across legal continuations: ${candidateIds.join(", ")}`
        }.`
      );
    }

    const continuationId =
      String(
        continuation.id
      );

    repairedPoints.splice(
      repairIndex + 1,
      0,
      {
        at:
          repairAt,

        clipId:
          continuationId,

        action:
          "cut",

        confidence:
          Math.min(
            item.confidence,
            0.95
          ),

        rationale:
          `Availability repair: '${item.clipId}' ends at ${availableEnd.toFixed(3)}s, so FREEOS hands off at ${repairAt.toFixed(3)}s to '${continuationId}', the uniquely legal continuation through ${plannedEnd.toFixed(3)}s.`,
      }
    );

    console.warn(
      `[FREEOS Editing Planner] repaired source overrun: ${item.clipId} -> ${continuationId} at ${repairAt.toFixed(3)}s`
    );

    repairIndex += 1;
  }


  /*
   * Candidate-strength anti-ping-pong analysis only belongs to the
   * section planner, because only it has section-local candidates.
   */
  if (
    candidateEditMoments.length > 0
  ) {
    assertNoMechanicalCameraPingPong(
      repairedPoints,
      candidateEditMoments
    );
  }


  return repairedPoints.map(
    (
      item,
      index
    ): EditingDecision => {
      const end =
        index + 1 <
        repairedPoints.length
          ? repairedPoints[
              index + 1
            ].at
          : sectionEnd;

      if (
        end <= item.at
      ) {
        throw new Error(
          `Section point ${index} does not advance the timeline.`
        );
      }

      const video =
        videos.find(
          (candidate) =>
            String(candidate.id) ===
            item.clipId
        );

      const availableStart =
        number(
          video?.timelineAvailableStart,
          0
        );

      const availableEnd =
        number(
          video?.timelineAvailableEnd,
          0
        );

      if (
        !video ||
        item.at <
          availableStart - 0.05 ||
        end >
          availableEnd + 0.05
      ) {
        throw new Error(
          `Section point ${index} keeps '${item.clipId}' on screen outside source availability (${item.at}-${end} vs ${availableStart}-${availableEnd}).`
        );
      }

      return {
        start:
          item.at,

        end,

        clipId:
          item.clipId,

        action:
          item.action,

        confidence:
          item.confidence,

        rationale:
          item.rationale,
      };
    }
  );
}
function assertNonDegenerateAssembly(reviewed: EditingDecision[], draft: EditingDecision[]): void {
  if (!reviewed.length || !draft.length) return;
  const reviewedStart = reviewed[0].start;
  const reviewedEnd = reviewed.at(-1)?.end ?? reviewedStart;
  const reviewedDuration = Math.max(0.001, reviewedEnd - reviewedStart);
  const draftStart = draft[0].start;
  const draftEnd = draft.at(-1)?.end ?? draftStart;
  const draftDuration = Math.max(0.001, draftEnd - draftStart);

  const coverage = (items: EditingDecision[]) => {
    const map = new Map<string, number>();
    for (const item of items) map.set(item.clipId, (map.get(item.clipId) ?? 0) + Math.max(0, item.end - item.start));
    return map;
  };

  const reviewedCoverage = coverage(reviewed);
  const draftCoverage = coverage(draft);
  const reviewedDominant = Math.max(...reviewedCoverage.values()) / reviewedDuration;
  const draftDominant = Math.max(...draftCoverage.values()) / draftDuration;
  const reviewedUnique = reviewedCoverage.size;
  const draftUnique = draftCoverage.size;

  const severeDominance = reviewedDominant >= 0.88 && reviewedDominant >= draftDominant + 0.18;
  const severeVarietyCollapse = draftUnique >= 4 && reviewedUnique <= 2 && reviewed.length <= 4;

  if (severeDominance || severeVarietyCollapse) {
    throw new Error(`Global assembly review over-collapsed the staged edit (dominantShare=${reviewedDominant.toFixed(3)}, draftDominantShare=${draftDominant.toFixed(3)}, reviewedCameras=${reviewedUnique}, draftCameras=${draftUnique}, reviewedSegments=${reviewed.length}). Preserve motivated camera variety while removing only unsupported boundary artifacts.`);
  }
}
function buildGroundedCautions(videos: JsonObject[], duration: number, availableEnd: number): string[] {
  const cautions: string[] = [];
  for (const video of videos) {
    const id = String(video.id);
    const flags = Array.isArray(video.qualityFlags) ? video.qualityFlags as JsonObject[] : [];
    const kinds = Array.from(new Set(flags.map((flag) => typeof flag.kind === "string" ? flag.kind : "").filter(Boolean)));
    if (kinds.length) cautions.push(`${id}: measured source-quality flags include ${kinds.join(", ")}.`);
    const notes = Array.isArray(video.semanticNotes) ? video.semanticNotes.filter((v): v is string => typeof v === "string").slice(0, 2) : [];
    for (const note of notes) cautions.push(`${id}: analyzer note â€” ${note}`);
  }
  if (availableEnd < duration - 0.05) {
    cautions.push(`No supplied video source covers the final ${(duration - availableEnd).toFixed(2)} seconds of the requested duration; FREEOS did not invent coverage.`);
  }
  return Array.from(new Set(cautions)).slice(0, 50);
}
function sectionEvidence(audio: JsonObject, videos: JsonObject[], start: number, end: number) {
  const audioWindows = Array.isArray(audio.windows) ? audio.windows as JsonObject[] : [];
  const availability = videos.map((video) => ({
    id: video.id,
    start: video.timelineAvailableStart,
    end: video.timelineAvailableEnd,
  })).filter((video) => number(video.end, 0) > start && number(video.start, 0) < end);

  const moments: JsonObject[] = [];
  for (let momentStart = start; momentStart < end; momentStart += 4) {
    const momentEnd = Math.min(end, momentStart + 4);
    const audioWindow = audioWindows.find((w) => number(w.end, 0) > momentStart && number(w.start, 0) < momentEnd);
    const candidates = videos.flatMap((video) => {
      if (number(video.timelineAvailableEnd, 0) <= momentStart || number(video.timelineAvailableStart, 0) >= momentEnd) return [];
      const windows = Array.isArray(video.windows) ? video.windows as JsonObject[] : [];
      const w = windows.find((item) => number(item.timelineEnd, 0) > momentStart && number(item.timelineStart, 0) < momentEnd);
      if (!w) return [];
      return [{
        id: video.id,
        sharpness: w.sharpness,
        brightness: w.brightness,
        motion: w.motion,
        facePresence: w.facePresence,
        multiFacePresence: w.multiFacePresence,
        primaryFaceArea: w.primaryFaceArea,
        sceneChangeMax: w.sceneChangeMax,
        underexposedFraction: w.underexposedFraction,
        overexposedFraction: w.overexposedFraction,
        personPresence: w.personPresence,
        personCountMean: w.personCountMean,
        subjectCountMean: w.subjectCountMean,
        primaryPersonArea: w.primaryPersonArea,
        globalMotion: w.globalMotion,
        localMotion: w.localMotion,
        shotScale: w.shotScale,
        shotScaleConfidence: w.shotScaleConfidence,
        framingRole: w.framingRole,
        framingRoleConfidence: w.framingRoleConfidence,
        motionRole: w.motionRole,
        motionRoleConfidence: w.motionRoleConfidence,
      }];
    });
    moments.push({
      start: Number(momentStart.toFixed(3)),
      end: Number(momentEnd.toFixed(3)),
      audio: audioWindow ? {
        energyMean: audioWindow.energyMean,
        transientCount: audioWindow.transientCount,
        strongestTransient: audioWindow.strongestTransient,
        beatCount: audioWindow.beatCount,
      } : null,
      candidates,
    });
  }

  return { start, end, tempo: audio.tempo, loudness: audio.loudness, availability, moments };
}
async function generateJson(input: {
  model?: string;
  system: string;
  prompt: unknown;
  schema?: JsonObject;
  timeoutMs: number;
  numPredict: number;
  temperature?: number;
}): Promise<string> {
  const model = input.model ?? config.heavyModel;

  const prompt =
    typeof input.prompt === "string"
      ? input.prompt
      : JSON.stringify(input.prompt);

  /*
   * Every call through generateJson() expects machine-readable JSON.
   *
   * When a concrete JSON Schema exists, pass that schema to Ollama.
   * When a stage does not define a custom schema (camera profiles, etc.),
   * still force Ollama JSON mode with "json".
   *
   * This is important for GPT-OSS because ollama.service routes structured
   * heavy-model calls through /api/chat and disables hidden thinking so the
   * generation budget is spent on complete message.content JSON.
   */
  const structuredFormat: JsonObject | "json" =
    input.schema ?? "json";

  const run = async (
    system: string,
    numPredict: number,
    temperature: number
  ): Promise<string> => {
    return generateWithOllama({
      model,
      think: true,
      system,
      prompt,
      format: structuredFormat,
      timeoutMs: input.timeoutMs,
      options: {
        temperature,
        top_p: 0.82,
        repeat_penalty: 1.08,
        num_predict: numPredict,
      },
    });
  };

  /*
   * Give structured output enough room on the first attempt.
   * The caller's requested budget is respected when it is larger.
   */
  const firstNumPredict = Math.max(
    input.numPredict,
    2400
  );

  let text = await run(
    input.system,
    firstNumPredict,
    input.temperature ?? 0.2
  );

  try {
    JSON.parse(text);
    return text;
  } catch (error) {
    console.warn(
      `[FREEOS Editing Planner] structured JSON invalid; retrying stage. ${
        error instanceof Error
          ? error.message
          : String(error)
      }`
    );
  }

  /*
   * Retry only this structured stage.
   * Do not restart media analysis or the entire edit-planning pipeline.
   */
  const retrySystem = `${input.system}

CRITICAL STRUCTURED OUTPUT RETRY:

Your previous response was incomplete or invalid JSON.

Return exactly ONE complete JSON value.

Requirements:
- Match the supplied JSON schema when one is present.
- When no custom schema is present, still return valid JSON only.
- Do not include markdown.
- Do not include commentary outside the JSON.
- Do not truncate strings.
- Do not omit closing quotes.
- Do not omit closing brackets.
- Do not omit closing braces.
- Finish the entire JSON value before stopping.`;

  const retryNumPredict = Math.max(
    input.numPredict * 2,
    5000
  );

  const retryTemperature = Math.min(
    input.temperature ?? 0.2,
    0.08
  );

  text = await run(
    retrySystem,
    retryNumPredict,
    retryTemperature
  );

  try {
    JSON.parse(text);
    return text;
  } catch (error) {
    throw new Error(
      `Structured planner JSON remained invalid after retry: ${
        error instanceof Error
          ? error.message
          : String(error)
      }`
    );
  }
}
export async function buildCreativeEditPlan(input: EditingPlannerRequest): Promise<EditingPlan> {
  if (!input.audioPath?.trim()) throw new Error("audioPath is required.");
  const included = input.clips.filter((clip) => !clip.exclude);
  if (!included.length) throw new Error("At least one non-excluded clip is required.");
  if (new Set(included.map((clip) => clip.id)).size !== included.length) throw new Error("Clip ids must be unique.");

  bootstrapEditingAcademy();
  const intent = input.userIntent ?? "Create the strongest complete performance edit from the available synchronized footage.";
  const editingKnowledge = buildEditingKnowledgeContext(intent);
  if (editingKnowledge.gap.needsMoreKnowledge) throw new Error(`Editing Academy knowledge gap: ${editingKnowledge.gap.reason} Query: ${editingKnowledge.gap.query}`);

  const sampleFps = Math.max(0.5, Math.min(4, input.sampleFps ?? 2));
  const [audioRaw, ...videoRaw] = await Promise.all([
    adobeService.run("media", "media.audio.analyze", { path: input.audioPath }),
    ...included.map((clip) => adobeService.run("media", "media.video.analyze", { path: clip.path, sampleFps })),
  ]);

  const audio = compactAudio(audioRaw);
  const videos = videoRaw.map((raw, index) => compactVideo(raw, included[index]));
  const inferredDuration = number(audio.durationSeconds, 0);
  const duration = input.durationSeconds && input.durationSeconds > 0 ? input.durationSeconds : inferredDuration;
  if (!duration) throw new Error("Could not determine edit duration.");

  const availableEnd = Math.min(duration, Math.max(...videos.map((video) => number(video.timelineAvailableEnd, 0))));
  const allowedClipIds = new Set(included.map((clip) => clip.id));
  const clipIds = included.map((clip) => clip.id);
  const cameraEvidence = videos.map((video) => ({
    clipId: String(video.id),
    timelineAvailability: {
      start: video.timelineAvailableStart,
      end: video.timelineAvailableEnd,
    },
    measuredSemanticSummary: video.summary,
    measuredQualityFlags: video.qualityFlags,
    analyzerNotes: video.semanticNotes,
    statisticsNote: "Any keys named p10, p50, or p90 are statistical percentiles, never clip ids or segment ids.",
  }));

  const cameraProfileSystem = `You are FREEOS's camera interpretation pass.

Produce exactly one grounded VISUAL profile for every supplied clipId and use only supplied clip ids.

STRICT EVIDENCE RULES:
- Describe only supplied measured visual or technical evidence.
- A detected face is only a detected face.
- Multiple detected faces are only multiple detected faces.
- Never call a detected person a performer, singer, musician, audience member, actor, or any other role.
- Never call multiple faces an ensemble, group performance, backing singers, crowd, or audience.
- Never invent lyrics, vocals, instruments, gestures, emotional expressions, story events, relationships, actions, or intent.
- Never invent rooms, stages, venues, environments, props, or unseen objects.
- Never convert face counts into story semantics.
- Never convert audio statistics into story semantics.
- Use neutral language such as tighter framing, wider framing, detected faces, face presence, centered-face ratio, motion, motion shift, scene-change evidence, brightness, sharpness, quality flags, and uncertainty.
- Metric/statistic names such as p10, p50, p90, mean, sharpness, brightness, and motion are not media identifiers.
- Do not rank cameras globally.
- Describe editorial utility only when directly supported by measured visual behavior.

Return only schema-valid JSON.`;
  const cameraProfileText = await generateJson({
    system: cameraProfileSystem,
    prompt: {
      validClipIds: clipIds,
      cameras: cameraEvidence,
    },
    schema: buildCameraProfileSchema(clipIds),
    timeoutMs: Math.max(config.ollamaGenerateTimeoutMs, 180_000),
    numPredict: 1800,
    temperature: 0.12,
  });
  const cameraProfiles =
    parseCameraProfiles(
      cameraProfileText,
      clipIds
    ).map(
      (profile) =>
        sanitizeStructuredStrings(
          profile
        )
    );
  const briefSystem = `You are FREEOS's senior editing director.

Build a concise editorial strategy from:
- the user's intent
- owner-approved Editing Academy guidance
- measured audio analysis
- grounded camera profiles

Do NOT output cuts yet.

EVIDENCE DISCIPLINE:
- Never invent lyrics or lyric moments.
- Never invent verse, chorus, bridge, pre-chorus, breakdown, hook, or outro labels unless those exact labels were supplied by measured analysis.
- Never invent performers, singers, backing singers, musicians, instruments, audience members, crowd behavior, rooms, objects, gestures, actions, or story events.
- Never infer a vocal flourish, harmony entrance, instrumental entrance, solo, chord change, melody event, or lyric emphasis unless supplied evidence explicitly identifies it.
- Face presence means only measured face presence.
- Multiple faces means only multiple detected faces.
- Multiple faces do not prove singers, audience, group roles, or ensemble behavior.
- Use neutral evidence language: audio energy change, measured transient, detected audio boundary, silence boundary, visual motion shift, framing change, scene change, face presence, source availability.
- If evidence is uncertain, say it is uncertain.

EDITORIAL JUDGMENT:
- Editing Academy guidance is not a preset.
- Camera profiles describe visual behavior, not rankings.
- Do not establish fixed cut cadence.
- Do not mechanically rotate cameras.
- Strong shots may hold.
- Faster cutting must arise from evidence density, not elapsed time.

${editingKnowledge.context}`;
  const briefText = await generateJson({
    system: briefSystem,
    prompt: {
      project: input.project,
      sequence: input.sequence,
      userIntent: intent,
      durationSeconds: duration,
      editableDurationSeconds: availableEnd,
      audio: { tempo: audio.tempo, loudness: audio.loudness, sections: audio.sections, silenceRegions: audio.silenceRegions, intro: audio.intro, outro: audio.outro },
      cameraProfiles,
    },
    schema: creativeBriefSchema,
    timeoutMs: Math.max(config.ollamaGenerateTimeoutMs, 180_000),
    numPredict: 1000,
    temperature: 0.25,
  });
  const rawBrief =
    parseCreativeBrief(
      briefText
    );

  const brief: CreativeBrief = {
    creativeSummary:
      sanitizeGroundedEditorialText(
        rawBrief.creativeSummary
      ),

    principles:
      rawBrief.principles.map(
        (item) =>
          sanitizeGroundedEditorialText(
            item
          )
      ),

    cautions:
      rawBrief.cautions.map(
        (item) =>
          sanitizeGroundedEditorialText(
            item
          )
      ),
  };

  const sectionSeconds = 48;
  const decisions: EditingDecision[] = [];
  const sectionCautions: string[] = [];
  let previousClipId = "";
  for (let sectionStart = 0; sectionStart < availableEnd; sectionStart += sectionSeconds) {
    const sectionEnd = Math.min(availableEnd, sectionStart + sectionSeconds);
    const evidence = sectionEvidence(audio, videos, sectionStart, sectionEnd);
    const availability = evidence.availability;

    /*
     * Real evidence-backed editing opportunities.
     * These are options, never mandatory cuts.
     */
    const candidateEditMoments =
      buildSectionEditMoments(
        audio,
        videos,
        sectionStart,
        sectionEnd
      );

    const candidateEditTimes =
      candidateEditMoments
        .map(
          (moment) =>
            number(
              moment.at,
              NaN
            )
        )
        .filter(
          (value) =>
            Number.isFinite(value)
        );


    const sectionEndCapableClipIds = availability
      .filter((item) => number(item.end, 0) >= sectionEnd - 0.001)
      .map((item) => String(item.id));

    const availabilityContract = availability.map((item) => ({
      clipId: String(item.id),
      availableStart: number(item.start, 0),
      availableEnd: number(item.end, 0),
    }));
    const sectionSystem = `You are FREEOS's section editor.

Create ONE chronological edit for ONLY timeline ${sectionStart.toFixed(3)} to ${sectionEnd.toFixed(3)}.

SECTION CONTINUITY:
- The start of this 48-second planning section is NOT automatically a creative cut.
- previousClipId is the camera active immediately before this section.
- If previousClipId remains available at sectionStart, use previousClipId as this section's opening clip.
- A genuine creative switch may happen moments later at an evidence-backed candidateEditMoment.
- Never change cameras merely because a planning section began.
- "section start" is never a creative rationale.

LOCAL-EVIDENCE DISCIPLINE:
- Every switch time must come from the enforced evidence-backed candidate schema.
- Each switch rationale may use ONLY evidence belonging to that exact candidateEditMoment.
- Never justify a switch using an event several seconds earlier or later.
- Candidate reasons are local evidence, not general evidence for the entire section.

CAMERA CONTINUITY:
- Do not create A-B-A or A-B-A-B patterns merely for visual variety.
- A rapid return to the previous camera requires strong local measured evidence.
- Very short inserts require unusually strong local evidence.
- When camera choices are otherwise similar, prefer continuity.

CUT-TIME POLICY:
- candidateEditMoments contains measured editorial opportunities derived from audio transients, detected audio boundaries, silence boundaries, scene changes, motion shifts, and source boundaries.
- Candidate edit moments are OPTIONS, not instructions to cut.
- Do NOT cut merely because a candidate exists.
- Do NOT turn candidate times into a repeating cadence.
- Do NOT approximate fixed spacing such as every 4, 8, or 16 seconds.
- Let actual evidence density and visual usefulness determine pacing.
- Long holds are valid.
- Several strong measured events close together may justify faster cutting.

HARD TIMELINE RULES:
- Choose an opening clip exactly at ${sectionStart.toFixed(3)}.
- A selected clip may remain active ONLY inside supplied source availability.
- Switch away no later than a source's availableEnd.
- The final active clip MUST be one of sectionEndCapableClipIds.
- Never assume source coverage beyond supplied values.
- Use absolute timeline seconds.

GROUNDING RULES:
- Never invent lyrics.
- Never invent verse, chorus, bridge, hook, or other song labels.
- Never invent singers, backing singers, performers, audience, instruments, rooms, objects, actions, story events, or emotional expressions.
- Multiple detected faces do NOT prove an ensemble or backing singers.
- Face presence does NOT identify a vocalist or performer.
- Rationales may cite only supplied measurements: framing, motion, visibility, quality, semantic confidence, scene changes, audio energy, transients, detected boundaries, silence, source availability, and creative strategy.
- Never claim a vocal flourish, lyrical emphasis, instrumental entrance, harmony, solo, chord, or melody event unless supplied evidence explicitly contains that fact.
- If semantic evidence is uncertain, say so.

CREATIVE RULES:
- Do not mechanically alternate cameras.
- Do not rank cameras using one metric.
- Technical metrics are evidence, not an editing formula.
- Keep a shot when it remains the strongest editorial choice.
- Switch only when evidence and creative strategy justify changing what the viewer receives.

Return only schema-valid JSON.`;
    const sectionPrompt = {
      userIntent: intent,
      creativeBrief: brief,
      previousClipId: previousClipId || null,
      availability,
      candidateEditMoments,
      availabilityContract,
      sectionEndCapableClipIds,
      cameraProfiles: cameraProfiles.filter((profile) => availability.some((item) => String(item.id) === profile.clipId)),
      evidence,
    };

    let sectionText = await generateJson({
      system: sectionSystem,
      prompt: sectionPrompt,
      schema: buildSectionPlanSchema(sectionStart, sectionEnd, videos, candidateEditTimes),
      timeoutMs: Math.max(config.ollamaGenerateTimeoutMs, 180_000),
      numPredict: 1800,
      temperature: 0.2,
    });

    let parsedSection: { opening: unknown; switches: unknown[]; cautions: string[] };
    let sectionDecisions: EditingDecision[];
    try {
      parsedSection = parseSectionPlan(sectionText);
      sectionDecisions = validateSectionSwitches(
        parsedSection.opening,
        parsedSection.switches,
        allowedClipIds,
        sectionStart,
        sectionEnd,
        videos,
        candidateEditMoments,
        previousClipId
      );
    } catch (error) {
      const failure = error instanceof Error ? error.message : String(error);
      console.error(`[FREEOS Editing Planner] section ${sectionStart}-${sectionEnd} validation failure: ${failure}`);
      console.error(`[FREEOS Editing Planner] section ${sectionStart}-${sectionEnd} response excerpt:`, sectionText.slice(0, 1600));
      sectionText = await generateJson({
        system: `REPAIR THIS SECTION FROM SCRATCH for ${sectionStart.toFixed(3)}-${sectionEnd.toFixed(3)} seconds.

The previous result FAILED validation.

CONTINUITY / LOCAL-EVIDENCE RULES:
- A 48-second planning boundary is not itself a creative cut.
- If previousClipId remains available at sectionStart, opening clip must remain previousClipId.
- Never create A-B-A or A-B-A-B patterns merely for visual variety.
- Every switch rationale must describe evidence local to the exact switch time.
- Never cite events several seconds away from the switch.
- Use neutral measured terminology only.

HARD RULES:
- Opening begins exactly at ${sectionStart.toFixed(3)}.
- Every selected clip must stay inside its supplied availability.
- Switch away from a clip no later than its availableEnd.
- The final active clip must come from sectionEndCapableClipIds.
- Use only supplied clip ids.
- Never invent people, ages, rooms, kitchens, objects, scenes, lyrics, actions, or story content.
- Rationales may mention only measured motion, framing, visibility, quality, semantic confidence, audio evidence, availability, or creative strategy.
- Do not mechanically alternate cameras.
- Do not use fixed intervals.
- Every switch time must come from candidateEditMoments / the enforced schema.
- candidateEditMoments are opportunities, not a cadence.
- Never manufacture a repeating 4-second, 8-second, 16-second, or other timing pattern.
- Never invent lyrics, song-section labels, performers, singers, audience, instruments, actions, or musical events.
- Return only complete schema-valid JSON.`,        prompt: {
          previousClipId: previousClipId || null,
          creativeBrief: brief,
          availability,
          candidateEditMoments,
          availabilityContract,
          sectionEndCapableClipIds,
          cameraProfiles: cameraProfiles.filter((profile) => availability.some((item) => String(item.id) === profile.clipId)),
          evidence,
          previousFailure: failure,
        },
        schema: buildSectionPlanSchema(sectionStart, sectionEnd, videos, candidateEditTimes),
        timeoutMs: Math.max(config.ollamaGenerateTimeoutMs, 150_000),
        numPredict: 1800,
        temperature: 0.05,
      });
      parsedSection = parseSectionPlan(sectionText);
      sectionDecisions = validateSectionSwitches(
        parsedSection.opening,
        parsedSection.switches,
        allowedClipIds,
        sectionStart,
        sectionEnd,
        videos,
        candidateEditMoments,
        previousClipId
      );
    }

    sectionCautions.push(
      ...parsedSection.cautions.filter((caution) =>
        /\b(source|availability|quality|semantic|uncertain|confidence|sharpness|brightness|motion|framing|visibility)\b/i.test(caution)
      )
    );
    const previousDecision =
      decisions.at(-1);

    const sectionOpening =
      sectionDecisions[0];

    if (
      previousDecision &&
      sectionOpening &&
      previousDecision.clipId === sectionOpening.clipId &&
      Math.abs(
        previousDecision.end -
        sectionOpening.start
      ) <= 0.001
    ) {
      /*
       * Same camera across an internal planning boundary:
       * keep the 48/96/144 implementation detail invisible.
       */
      previousDecision.end =
        sectionOpening.end;

      decisions.push(
        ...sectionDecisions.slice(1)
      );
    }
    else {
      decisions.push(
        ...sectionDecisions
      );
    }

    previousClipId =
      decisions.at(-1)?.clipId ??
      previousClipId;
  }

  const internalBoundaries = [48, 96, 144].filter((boundary) => boundary > 0 && boundary < availableEnd);
  const boundaryContexts = internalBoundaries.map((boundary) => ({
    boundary,
    context: sectionEvidence(audio, videos, Math.max(0, boundary - 8), Math.min(availableEnd, boundary + 8)),
  }));

  let assemblyReviewApplied = false;
  let assemblyReviewFailure: string | undefined;
  let assemblyBoundaryPrunes = 0;
  let reviewedDecisions = decisions.map((decision) => ({ ...decision }));

  try {
    const candidateSwitches = decisions
      .slice(1)
      .filter((decision) => internalBoundaries.some((boundary) => Math.abs(decision.start - boundary) <= 6.001))
      .map((decision) => Number(decision.start.toFixed(3)));

    const uniqueCandidateTimes = Array.from(new Set(candidateSwitches)).sort((a, b) => a - b);
    const candidateDetails = uniqueCandidateTimes.map((at) => {
      const index = decisions.findIndex((decision) => Math.abs(decision.start - at) <= 0.001);
      return {
        at,
        before: index > 0 ? decisions[index - 1] : null,
        after: index >= 0 ? decisions[index] : null,
        nearestBoundary: internalBoundaries.reduce((best, boundary) => Math.abs(boundary - at) < Math.abs(best - at) ? boundary : best, internalBoundaries[0] ?? at),
      };
    });

    const pruneSystem = `You are FREEOS's senior finishing editor performing a SURGICAL boundary cleanup on an already-valid multicam draft. You may only remove existing switchpoints listed in candidateSwitches. The 48/96/144-second boundaries are internal planning artifacts, not creative events. Remove a candidate switch only when it looks like a boundary-driven burst, redundant handoff, or section-end artifact. Do not redesign the whole edit, do not add switchpoints, do not change cameras elsewhere, and do not remove motivated short bursts merely because they are short. Returning an empty removeSwitches array is valid. Camera profiles describe visual character, not rankings.`;

    const pruneText = await generateJson({
      system: pruneSystem,
      prompt: {
        userIntent: intent,
        creativeBrief: brief,
        cameraProfiles,
        candidateSwitches: candidateDetails,
        boundaryContexts,
        draftDecisions: decisions,
      },
      schema: buildBoundaryPruneSchema(uniqueCandidateTimes),
      timeoutMs: Math.max(config.ollamaGenerateTimeoutMs, 120_000),
      numPredict: 900,
      temperature: 0.08,
    });

    const parsedPrune = asObject(JSON.parse(pruneText), "boundary prune response");
    const requestedRemovals = Array.isArray(parsedPrune.removeSwitches)
      ? parsedPrune.removeSwitches.filter((value): value is number => typeof value === "number" && Number.isFinite(value))
      : [];
    const allowedRemovalTimes = new Set(uniqueCandidateTimes.map((value) => value.toFixed(3)));

    for (const requestedAt of requestedRemovals.sort((a, b) => a - b)) {
      const at = Number(requestedAt.toFixed(3));
      if (!allowedRemovalTimes.has(at.toFixed(3))) continue;
      const index = reviewedDecisions.findIndex((decision) => Math.abs(decision.start - at) <= 0.001);
      if (index <= 0) continue;

      const previous = reviewedDecisions[index - 1];
      const current = reviewedDecisions[index];
      const previousVideo = videos.find((video) => String(video.id) === previous.clipId);
      const availableEndForPrevious = number(previousVideo?.timelineAvailableEnd, 0);

      // Removing a switch means the preceding shot continues through the removed segment.
      // Reject that removal deterministically if the preceding source cannot cover it.
      if (!previousVideo || current.end > availableEndForPrevious + 0.05) continue;

      previous.end = current.end;
      previous.confidence = Math.min(previous.confidence, current.confidence);
      reviewedDecisions.splice(index, 1);
      assemblyBoundaryPrunes += 1;
    }

    assertNonDegenerateAssembly(reviewedDecisions, decisions);
    assemblyReviewApplied = true;
    assemblyReviewFailure = undefined;
  } catch (error) {
    assemblyReviewFailure = error instanceof Error ? error.message : String(error);
    reviewedDecisions = decisions.map((decision) => ({ ...decision }));
    assemblyBoundaryPrunes = 0;
    console.error(`[FREEOS Editing Planner] surgical boundary review failed; preserving valid staged draft: ${assemblyReviewFailure}`);
  }
  const normalizedDecisions: EditingDecision[] = [];
  for (const decision of reviewedDecisions) {
    const previous = normalizedDecisions.at(-1);
    if (previous && previous.clipId === decision.clipId && previous.action === decision.action && Math.abs(previous.end - decision.start) <= 0.02) {
      previous.end = decision.end;
      previous.confidence = Math.min(previous.confidence, decision.confidence);
      if (!previous.rationale && decision.rationale) previous.rationale = decision.rationale;
      continue;
    }
    normalizedDecisions.push({ ...decision });
  }
  for (let i = 1; i < normalizedDecisions.length; i++) {
    if (normalizedDecisions[i].start < normalizedDecisions[i - 1].end - 0.01) {
      throw new Error(`Combined planner decisions overlap near ${normalizedDecisions[i].start}.`);
    }
  }
  const cautions = buildGroundedCautions(videos, duration, availableEnd);

  return {
    version: "freeos-creative-planner-v5.6-boundary-prune-review",
    durationSeconds: duration,
    creativeSummary: brief.creativeSummary,
    decisions: normalizedDecisions,
    cautions,
    evidence: {
      audioAnalysisVersion: typeof audio.analysisVersion === "string" ? audio.analysisVersion : undefined,
      videoAnalysisVersions: Object.fromEntries(videos.map((video) => [String(video.id), typeof video.analysisVersion === "string" ? video.analysisVersion : undefined])),
      editingKnowledgeUnits: editingKnowledge.gap.relevantUnits,
      editingKnowledgeGap: editingKnowledge.gap.needsMoreKnowledge,
      plannerMode: "academy-guided-camera-profile-boundary-prune-review",
      cameraProfileCount: cameraProfiles.length,
      assemblyReviewApplied,
      assemblyBoundaryPrunes,
      assemblyReviewFailure,
    },
  };
}
